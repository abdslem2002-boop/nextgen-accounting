<!DOCTYPE html>
<html dir="rtl" lang="ar">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>🤖 منصة الدردشة الذكية</title>
    <style>
        /* ===== كل الأنماط هنا ===== */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        body {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 20px;
        }

        .container {
            background: white;
            border-radius: 20px;
            box-shadow: 0 20px 60px rgba(0,0,0,0.3);
            width: 100%;
            max-width: 800px;
            height: 90vh;
            max-height: 700px;
            display: flex;
            flex-direction: column;
            overflow: hidden;
        }

        header {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            padding: 18px 25px;
            text-align: center;
            flex-shrink: 0;
        }

        header h1 {
            font-size: 22px;
            font-weight: 700;
        }

        header p {
            font-size: 13px;
            opacity: 0.9;
            margin-top: 4px;
        }

        /* منطقة عرض المحادثة */
        #chat-box {
            flex: 1;
            overflow-y: auto;
            padding: 20px;
            background: #f8f9fa;
            display: flex;
            flex-direction: column;
            gap: 10px;
        }

        .message {
            padding: 12px 18px;
            border-radius: 18px;
            max-width: 80%;
            word-wrap: break-word;
            animation: fadeIn 0.3s ease;
            line-height: 1.6;
            font-size: 15px;
        }

        .user-message {
            background: #667eea;
            color: white;
            align-self: flex-end;
            border-bottom-right-radius: 5px;
        }

        .bot-message {
            background: white;
            color: #333;
            align-self: flex-start;
            border-bottom-left-radius: 5px;
            box-shadow: 0 2px 8px rgba(0,0,0,0.08);
        }

        .bot-message .loading-dots {
            display: inline-block;
        }

        .bot-message .loading-dots span {
            animation: blink 1.4s infinite both;
            display: inline-block;
            font-size: 20px;
        }

        .bot-message .loading-dots span:nth-child(2) {
            animation-delay: 0.2s;
        }
        .bot-message .loading-dots span:nth-child(3) {
            animation-delay: 0.4s;
        }

        @keyframes blink {
            0%, 80%, 100% { opacity: 0; }
            40% { opacity: 1; }
        }

        /* منطقة الإدخال */
        .input-area {
            display: flex;
            padding: 15px 20px;
            background: white;
            border-top: 1px solid #e8e8e8;
            gap: 10px;
            flex-shrink: 0;
        }

        #user-input {
            flex: 1;
            padding: 12px 18px;
            border: 2px solid #e8e8e8;
            border-radius: 25px;
            font-size: 15px;
            outline: none;
            transition: border 0.3s;
            background: #fafafa;
        }

        #user-input:focus {
            border-color: #667eea;
            background: white;
        }

        #user-input:disabled {
            opacity: 0.6;
        }

        #send-btn {
            padding: 12px 28px;
            background: linear-gradient(135deg, #667eea, #764ba2);
            color: white;
            border: none;
            border-radius: 25px;
            font-size: 15px;
            font-weight: 600;
            cursor: pointer;
            transition: transform 0.2s, opacity 0.2s;
            white-space: nowrap;
        }

        #send-btn:hover:not(:disabled) {
            transform: scale(1.04);
        }

        #send-btn:disabled {
            opacity: 0.6;
            cursor: not-allowed;
            transform: none;
        }

        /* شريط التمرير المخصص */
        #chat-box::-webkit-scrollbar {
            width: 6px;
        }
        #chat-box::-webkit-scrollbar-track {
            background: #f1f1f1;
            border-radius: 10px;
        }
        #chat-box::-webkit-scrollbar-thumb {
            background: #667eea;
            border-radius: 10px;
        }

        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(12px); }
            to { opacity: 1; transform: translateY(0); }
        }

        /* زر تغيير المفتاح */
        .settings-area {
            display: flex;
            justify-content: center;
            padding: 8px 20px 0;
            gap: 10px;
            flex-shrink: 0;
            background: #f8f9fa;
        }

        .settings-area button {
            background: transparent;
            border: none;
            color: #667eea;
            font-size: 12px;
            cursor: pointer;
            text-decoration: underline;
            padding: 4px 10px;
        }

        .settings-area button:hover {
            color: #764ba2;
        }

        /* رسالة الخطأ */
        .error-message {
            background: #fee;
            color: #c0392b;
            align-self: center;
            max-width: 90%;
            text-align: center;
            border: 1px solid #f5c6cb;
        }

        /* توافق الجوال */
        @media (max-width: 600px) {
            .container {
                height: 95vh;
                max-height: none;
                border-radius: 12px;
            }
            .message {
                max-width: 90%;
                font-size: 14px;
                padding: 10px 14px;
            }
            header h1 { font-size: 18px; }
            #send-btn { padding: 10px 18px; font-size: 14px; }
            #user-input { font-size: 14px; padding: 10px 14px; }
        }
    </style>
</head>
<body>

<div class="container">
    <header>
        <h1>🤖 محادثتي الذكية</h1>
        <p>مدعوم بـ Llama 3.2 عبر OpenRouter</p>
    </header>

    <div id="chat-box"></div>

    <div class="settings-area">
        <button id="change-key-btn">🔑 تغيير مفتاح API</button>
        <button id="clear-chat-btn">🗑️ مسح المحادثة</button>
    </div>

    <div class="input-area">
        <input type="text" id="user-input" placeholder="اكتب رسالتك هنا..." autofocus>
        <button id="send-btn">إرسال ➤</button>
    </div>
</div>

<script>
    // ===== كل الكود هنا =====

    // ---------- الإعدادات ----------
    // يمكنك وضع مفتاحك مباشرة هنا، أو ترك المستخدم يدخله
    let API_KEY = localStorage.getItem('openrouter_api_key') || '';
    const SITE_URL = window.location.origin;
    const SITE_NAME = 'AI Chat App';

    // ---------- عناصر DOM ----------
    const chatBox = document.getElementById('chat-box');
    const userInput = document.getElementById('user-input');
    const sendBtn = document.getElementById('send-btn');
    const changeKeyBtn = document.getElementById('change-key-btn');
    const clearChatBtn = document.getElementById('clear-chat-btn');

    let chatHistory = [];
    let isWaiting = false;

    // ---------- دالة إضافة رسالة ----------
    function addMessage(text, sender, isError = false) {
        const messageDiv = document.createElement('div');
        messageDiv.className = `message ${sender}-message`;
        if (isError) messageDiv.classList.add('error-message');
        messageDiv.textContent = text;
        chatBox.appendChild(messageDiv);
        chatBox.scrollTop = chatBox.scrollHeight;
        return messageDiv;
    }

    // ---------- دالة إظهار مؤشر الكتابة ----------
    function showTypingIndicator() {
        const div = document.createElement('div');
        div.className = 'message bot-message';
        div.id = 'typing-indicator';
        div.innerHTML = `
            <span class="loading-dots">
                <span>.</span><span>.</span><span>.</span>
            </span>
        `;
        chatBox.appendChild(div);
        chatBox.scrollTop = chatBox.scrollHeight;
        return div;
    }

    // ---------- دالة إزالة مؤشر الكتابة ----------
    function removeTypingIndicator() {
        const indicator = document.getElementById('typing-indicator');
        if (indicator) indicator.remove();
    }

    // ---------- دالة التحقق من المفتاح ----------
    function checkApiKey() {
        if (!API_KEY) {
            const userKey = prompt('🔑 يرجى إدخال مفتاح OpenRouter API الخاص بك:\n(احصل عليه من https://openrouter.ai/keys)');
            if (userKey) {
                API_KEY = userKey.trim();
                localStorage.setItem('openrouter_api_key', API_KEY);
                addMessage('✅ تم حفظ المفتاح! يمكنك بدء المحادثة.', 'bot');
                return true;
            } else {
                addMessage('⚠️ لا يمكن استخدام التطبيق بدون مفتاح API. يرجى إدخال مفتاح صحيح.', 'bot', true);
                return false;
            }
        }
        return true;
    }

    // ---------- دالة إرسال الرسالة الأساسية ----------
    async function sendMessageToAI(message) {
        if (isWaiting) return;
        if (!message.trim()) return;

        // إذا لم يوجد مفتاح، اطلب من المستخدم إدخاله
        if (!API_KEY) {
            const hasKey = checkApiKey();
            if (!hasKey) return;
        }

        // إضافة رسالة المستخدم
        addMessage(message, 'user');
        userInput.value = '';
        userInput.disabled = true;
        sendBtn.disabled = true;
        isWaiting = true;

        // إظهار مؤشر الكتابة
        const typingIndicator = showTypingIndicator();

        try {
            // بناء تاريخ المحادثة (آخر 10 رسائل فقط لتوفير السياق)
            const contextMessages = chatHistory.slice(-10).map(msg => ({
                role: msg.role,
                content: msg.content
            }));

            const response = await fetch('https://openrouter.ai/api/v1/chat/completions', {
                method: 'POST',
                headers: {
                    'Authorization': `Bearer ${API_KEY}`,
                    'Content-Type': 'application/json',
                    'HTTP-Referer': SITE_URL,
                    'X-Title': SITE_NAME
                },
                body: JSON.stringify({
                    model: 'meta-llama/llama-3.2-3b-instruct:free',
                    messages: [
                        { role: 'system', content: 'أنت مساعد ذكي ومفيد. أجب باللغة العربية دائماً. كن مختصراً وواضحاً.' },
                        ...contextMessages,
                        { role: 'user', content: message }
                    ],
                    max_tokens: 800,
                    temperature: 0.7,
                    top_p: 0.9
                })
            });

            // إزالة مؤشر الكتابة
            removeTypingIndicator();

            if (!response.ok) {
                const errorData = await response.json();
                let errorMsg = 'حدث خطأ في الخادم.';
                if (errorData.error?.message?.includes('credits')) {
                    errorMsg = '⚠️ رصيدك غير كافٍ. يرجى شحن حسابك على OpenRouter.';
                } else if (errorData.error?.message) {
                    errorMsg = `❌ ${errorData.error.message}`;
                }
                addMessage(errorMsg, 'bot', true);
                return;
            }

            const data = await response.json();
            const reply = data.choices?.[0]?.message?.content || 'عذراً، لم أتلقَ رداً.';

            addMessage(reply, 'bot');

            // حفظ المحادثة
            chatHistory.push(
                { role: 'user', content: message },
                { role: 'assistant', content: reply }
            );

            // حفظ آخر 50 رسالة فقط
            if (chatHistory.length > 50) {
                chatHistory = chatHistory.slice(-50);
            }

        } catch (error) {
            removeTypingIndicator();
            console.error('خطأ:', error);
            addMessage('❌ حدث خطأ في الاتصال. تحقق من اتصالك بالإنترنت وحاول مرة أخرى.', 'bot', true);
        } finally {
            userInput.disabled = false;
            sendBtn.disabled = false;
            isWaiting = false;
            userInput.focus();
        }
    }

    // ---------- معالج الإرسال ----------
    function handleSend() {
        const message = userInput.value.trim();
        if (message) {
            sendMessageToAI(message);
        }
    }

    // ---------- مسح المحادثة ----------
    function clearChat() {
        if (chatHistory.length === 0) return;
        if (confirm('هل تريد مسح جميع رسائل المحادثة؟')) {
            chatBox.innerHTML = '';
            chatHistory = [];
            addMessage('🗑️ تم مسح المحادثة. ابدأ محادثة جديدة!', 'bot');
            userInput.focus();
        }
    }

    // ---------- تغيير المفتاح ----------
    function changeApiKey() {
        const newKey = prompt('🔑 أدخل مفتاح OpenRouter API الجديد:', API_KEY);
        if (newKey !== null && newKey.trim()) {
            API_KEY = newKey.trim();
            localStorage.setItem('openrouter_api_key', API_KEY);
            addMessage('✅ تم تحديث مفتاح API بنجاح!', 'bot');
        } else if (newKey === '') {
            API_KEY = '';
            localStorage.removeItem('openrouter_api_key');
            addMessage('⚠️ تم حذف المفتاح. ستحتاج لإدخال مفتاح لاستخدام التطبيق.', 'bot', true);
        }
    }

    // ---------- الأحداث ----------
    sendBtn.addEventListener('click', handleSend);

    userInput.addEventListener('keypress', (e) => {
        if (e.key === 'Enter' && !e.shiftKey) {
            e.preventDefault();
            handleSend();
        }
    });

    changeKeyBtn.addEventListener('click', changeApiKey);
    clearChatBtn.addEventListener('click', clearChat);

    // ---------- رسالة الترحيب ----------
    window.addEventListener('DOMContentLoaded', () => {
        if (API_KEY) {
            addMessage('👋 مرحباً! أنا مساعدك الذكي. كيف يمكنني مساعدتك اليوم؟', 'bot');
        } else {
            addMessage('👋 مرحباً! يرجى الضغط على "تغيير مفتاح API" لإدخال مفتاحك للبدء.', 'bot');
            // محاولة طلب المفتاح تلقائياً
            setTimeout(() => {
                if (!API_KEY) checkApiKey();
            }, 500);
        }
        userInput.focus();
    });

    // ---------- حفظ المحادثة في localStorage (اختياري) ----------
    // يمكن إضافة حفظ تلقائي للمحادثة هنا إذا أردت
</script>

</body>
</html>